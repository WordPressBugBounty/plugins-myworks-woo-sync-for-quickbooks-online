*.log
*.tmp
*.temp
error_log
debug.log

# Log files
logs/
*.log

# Cache files
cache/
*.cache

# Temporary files
tmp/
temp/

# Backup files
*.bak
*.backup
*.old
*~

# Database files
*.sql
*.sqlite
*.db

# Configuration files (if any)
config.php
local-config.php

# Node.js (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Composer (if using PHP dependencies)
/vendor/
composer.lock

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.buildpath
.DS_Store
Thumbs.db

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claude AI specific files
CLAUDE.md
claude.md
.claude/

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

