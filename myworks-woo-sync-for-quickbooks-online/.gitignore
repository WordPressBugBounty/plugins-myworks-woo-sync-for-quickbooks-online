phpunit.xml
.phpunit.result.cache

# Coverage reports
coverage/
coverage.xml
clover.xml

# Sass/CSS
*.css.map
*.sass.map
*.scss.map

# Image originals (keep compressed versions)
*.psd
*.ai
*.sketch

# Development tools
.editorconfig
.eslintrc*
.prettierrc*
.stylelintrc*
webpack.config.js
gulpfile.js
Gruntfile.js

